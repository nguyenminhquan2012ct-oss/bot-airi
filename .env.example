# Discord Bot Configuration
DISCORD_TOKEN=your_discord_bot_token_here

# AI Provider Configuration
# Supported: ollama, openai, openrouter, groq
AI_PROVIDER=ollama
AI_BASE_URL=http://localhost:11434/v1
AI_API_KEY=
AI_MODEL=qwen2.5:7b
AI_TIMEOUT=30

# Database Configuration
# SQLite (default): sqlite+aiosqlite:///airi.db
# PostgreSQL: postgresql+asyncpg://user:password@localhost/airi
DATABASE_URL=sqlite+aiosqlite:///airi.db

# RPG & Gameplay Configuration
XP_COOLDOWN=60
XP_PER_MESSAGE=10
LEVEL_BASE_XP=100
LEVEL_MULTIPLIER=1.5

# World Engine Configuration
WORLD_TICK_INTERVAL=300
WORLD_EVENT_CHANCE=0.15

# Feature Toggles
ENABLE_ROAST=true
ENABLE_WORLD_EVENTS=true
ENABLE_DETECTIVE=true
ENABLE_WHATIF=true

# Logging Configuration
LOG_LEVEL=INFO
